# ─────────────────────────────────────────────────────────────────────────────
# MRTO environment configuration (TEMPLATE) — Phase 4 expanded
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All secrets below can ALSO be supplied via:
#   - `<NAME>_FILE=/path/to/file` (Docker/K8s secret mount)
#   - Vault (set MRTO_VAULT_ADDR + MRTO_VAULT_TOKEN)
#   - SOPS (set MRTO_SOPS_FILE=/path/to/secrets.yaml)
# See docs/DEPLOYMENT.md for the secrets-management guide.
# ─────────────────────────────────────────────────────────────────────────────

# Container image — set to the GHCR image tagged by CI/CD
MRTO_IMAGE=ghcr.io/parsasohrab1/inno-marjan-petrochemical:latest

# ── Secrets (HIGH SENSITIVITY) ────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -hex 32
MRTO_JWT_SECRET=change-me-in-production
# Initial admin credentials — change before first boot. If left empty,
# the app generates a strong random one and prints it once to stdout.
MRTO_ADMIN_USER=admin
MRTO_ADMIN_PASS=change-me-before-deploy

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite path (dev/test). For production set MRTO_DATABASE_URL to a Postgres DSN.
MRTO_DB_PATH=/app/data/mrto.sqlite3
# Postgres DSN (production). Overrides MRTO_DB_PATH when set.
# MRTO_DATABASE_URL=postgresql://mrto:CHANGE_ME@db-host:5432/mrto?sslmode=require
# Optional read replica — GET endpoints route here when set.
# MRTO_READ_REPLICA_URL=postgresql://mrto:CHANGE_ME@replica-host:5432/mrto?sslmode=require

# ── Storage paths (inside container) ─────────────────────────────────────────
MRTO_MODELS_DIR=/app/models

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO
# Set MRTO_LOG_PRETTY=1 for human-readable docker logs (dev only).
MRTO_LOG_PRETTY=0
# Host port for the reverse proxy
MRTO_PORT=8080

# ── Auth ─────────────────────────────────────────────────────────────────────
# Access-token TTL (seconds) — default 8h.
MRTO_JWT_TTL=28800
# Refresh-token TTL (seconds) — default 30d.
MRTO_REFRESH_TTL=2592000
# Allow anonymous read-only viewer when no Bearer token is present.
# Set to 0 in production so unauthenticated requests get 401.
MRTO_ALLOW_ANON=0
# Bypass the JWT-secret strength check (DEV/TEST ONLY — never in prod).
# MRTO_ALLOW_INSECURE_JWT=1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Default: localhost only.
# Production: the public dashboard URL.
MRTO_CORS_ORIGINS=https://mrto.example.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Global per-IP limit (default 100 req / 60s).
MRTO_RATE_LIMIT=100
MRTO_RATE_WINDOW=60

# ── Secrets backends (optional) ──────────────────────────────────────────────
# HashiCorp Vault. Leave MRTO_VAULT_ADDR unset to disable the Vault backend.
# MRTO_VAULT_ADDR=https://vault.internal:8200
# MRTO_VAULT_TOKEN_FILE=/mnt/secrets/vault-token
# MRTO_VAULT_MOUNT=secret
# MRTO_VAULT_PATH=mrto
# SOPS-encrypted file. Requires `sops` on PATH.
# MRTO_SOPS_FILE=/etc/mrto/secrets.sops.yaml

# ── Kubernetes-only (used by deploy/k8s) ─────────────────────────────────────
MRTO_HOST=mrto.example.com
MRTO_NAMESPACE=mrto
MRTO_REPLICAS=2

# ── Backup (used by scripts/backup.py) ───────────────────────────────────────
# Local backup directory (host). The cron job rotates files here.
MRTO_BACKUP_DIR=/var/backups/mrto
# Number of daily backups to retain.
MRTO_BACKUP_RETAIN=14
